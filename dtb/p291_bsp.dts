		spicc {
			phandle = <0xa4>;

			mux {
				groups = "spi_sclk_1\0spi_miso_1\0spi_mosi_1\0spi_ss0_1";
				function = "spi";
			};
		};

		lcd_ttl_rgb_8bit_on {
			phandle = <0xac>;

			mux {
				groups = "lcd_r0_1\0lcd_r2_7\0lcd_g0_1\0lcd_g2_7\0lcd_b0_1\0lcd_b2_7";
				function = "lcd_ttl";
			};
		};

		sdio_all_pins {
			phandle = <0x4e>;

			mux {
				groups = "sdio_d0\0sdio_d1\0sdio_d2\0sdio_d3\0sdio_clk\0sdio_cmd";
				function = "sdio";
				input-enable;
				bias-pull-up;
			};
		};

		sd_iso7816_pins {
			phandle = <0x98>;

			mux {
				groups = "iso7816_clk_dv\0iso7816_data_dv";
				function = "iso7816";
				bias-pull-down;
				input-enable;
			};
		};

		c_i2c_pin1 {
			phandle = <0x9e>;

			mux {
				groups = "i2c_sda_c_dv18\0i2c_scl_c_dv19";
				function = "i2c_c";
			};
		};

		spicc_pulldown_z11z12z13 {
			phandle = <0xa0>;

			mux {
				groups = "spi_sclk_0\0spi_miso_0\0spi_mosi_0";
				function = "spi";
			};
		};

		hdmitx_hpd {
			phandle = <0x6e>;

			mux {
				groups = "hdmi_hpd";
				function = "hdmi_hpd";
			};
		};

		emmc_clk_cmd_pins {
			phandle = <0x44>;

			mux {
				groups = "emmc_cmd\0emmc_clk";
				function = "emmc";
				input-enable;
				bias-pull-up;
			};
		};

		a_uart {
			phandle = <0x17>;

			mux1 {
				groups = "uart_cts_a";
				function = "uart_a";
				bias-pull-down;
			};

			mux {
				groups = "uart_tx_a\0uart_rx_a\0uart_rts_a";
				function = "uart_a";
			};
		};

		spicc_pullup_z11z12z13 {
			phandle = <0xa1>;

			mux {
				groups = "spi_sclk_0\0spi_miso_0\0spi_mosi_0";
				function = "spi";
			};
		};
	};

	dvb {
		ts2 = "parallel";
		compatible = "amlogic, dvb";
		clocks = <0x08 0x35 0x08 0x26 0x08 0x49 0x08 0x46>;
		dev_name = "dvb";
		ts2_invert = <0x00>;
		clock-names = "demux\0asyncfifo\0ahbarb0\0uparsertop";
		status = "disabled";
		interrupts = <0x00 0x17 0x01 0x00 0x05 0x01 0x00 0x35 0x01 0x00 0x13 0x01 0x00 0x19 0x01 0x00 0x12 0x01 0x00 0x18 0x01>;
		interrupt-names = "demux0_irq\0demux1_irq\0demux2_irq\0dvr0_irq\0dvr1_irq\0dvrfill0_fill\0dvrfill1_flush";
		ts2_control = <0x00>;
	};

	memory@00000000 {
		device_type = "memory";
		linux,usable-memory = <0x100000 0x3ff00000>;
		reg = <0x00 0x38000000>;
	};

	spdif_codec {
		compatible = "amlogic, aml-spdif-codec";
		#sound-dai-cells = <0x00>;
		phandle = <0x80>;
		pinctrl-0 = <0x72>;
		pinctrl-names = "audio_spdif_out";
	};

	timer_bc {
		clockevent-rating = <0x12c>;
		compatible = "arm, meson-bc-timer";
		bit_enable = <0x10>;
		timer_name = "Meson TimerF";
		clockevent-features = <0x23>;
		bit_mode = <0x0c>;
		interrupts = <0x00 0x3c 0x01>;
		reg = <0xc1109990 0x04 0xc1109994 0x04>;
		bit_resolution = <0x00>;
		clockevent-shift = <0x14>;
	};

	efuse {
		compatible = "amlogic, efuse";
		clocks = <0x08 0x4a>;
		read_cmd = <0x82000030>;
		get_max_cmd = <0x82000033>;
		clock-names = "efuse_clk";
		write_cmd = <0x82000031>;
		status = "disabled";
		key = <0x1b>;
		phandle = <0xc3>;
	};

	ppmgr {
		compatible = "amlogic, ppmgr";
		dev_name = "ppmgr";
		status = "okay";
		memory-region = <0x40>;
	};

	rtc {
		compatible = "amlogic, aml_vrtc";
		alarm_reg_addr = <0xc81000a8>;
		timer_e_addr = <0xc1109988>;
		status = "okay";
		init_date = "2020/01/01";
	};

	mtd_nand {
		compatible = "amlogic, aml_mtd_nand";
		dev_name = "mtdnand";
		plat-names = "bootloader\0nandnormal";
		pinctrl-1 = <0x4f>;
		plat-part-0 = <0x51>;
		status = "disabled";
		interrupts = <0x00 0x22 0x01>;
		pinctrl-2 = <0x50>;
		reg = <0xd0074800 0x200>;
		plat-part-1 = <0x52>;
		pinctrl-0 = <0x4f>;
		device_id = <0x00>;
		plat-num = <0x02>;
		pinctrl-names = "nand_rb_mod\0nand_norb_mod\0nand_cs_only";

		nandnormal {
			t_rhoh = <0x0f>;
			plane_mode = "twoplane";
			rb_detect = <0x01>;
			partition = <0x53>;
			t_rea = <0x14>;
			phandle = <0x52>;
			busy_pad = "rb0\0rb1";
			part_num = <0x03>;
			timming_mode = "mode5";
			chip_num = <0x02>;
			enable_pad = "ce0\0ce1";
			bch_mode = "bch60_1k";
		};

		bootloader {
			t_rhoh = <0x0f>;
			rb_detect = <0x01>;
			t_rea = <0x14>;
			phandle = <0x51>;
			busy_pad = "rb0";
			part_num = <0x00>;
			timming_mode = "mode5";
			chip_num = <0x01>;
			enable_pad = "ce0";
			bch_mode = "bch60_1k";
		};

		nand_partition {
			phandle = <0x53>;

			logo {
				offset = <0x00 0x00>;
				size = <0x00 0x200000>;
			};

			system {
				offset = <0x00 0x00>;
				size = <0x00 0xdc40000>;
			};

			data {
				offset = <0xffffffff 0xffffffff>;
				size = <0x00 0x00>;
			};

			recovery {
				offset = <0x00 0x00>;
				size = <0x00 0x1000000>;
			};

			boot {
				offset = <0x00 0x00>;
				size = <0x00 0xc00000>;
			};
		};
	};

	ge2d {
		compatible = "amlogic, ge2d-gxl";
		clocks = <0x08 0xc4 0x08 0x41 0x08 0xc5>;
		dev_name = "ge2d";
		clock-names = "clk_vapb_0\0clk_ge2d\0clk_ge2d_gate";
		status = "okay";
		interrupts = <0x00 0x96 0x01>;
		interrupt-names = "ge2d";
	};

	pinctrl@14 {
		compatible = "amlogic,meson-gxlx-aobus-pinctrl";
		ranges;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		phandle = <0x8f>;

		remote_pin {
			phandle = <0x20>;

			mux {
				groups = "remote_input";
				function = "remote";
			};
		};

		sd_to_ao_uart_clr_pins {
			phandle = <0x4a>;

			mux {
				groups = "GPIOAO_0\0GPIOAO_1";
				function = "gpio_aobus";
			};
		};

		hdmitx_eecec {
			phandle = <0x93>;

			mux {
				groups = "ee_cec";
				function = "ee_cec";
			};
		};

		bank@14 {
			reg-names = "mux\0pull\0gpio";
			gpio-controller;
			phandle = <0x90>;
			reg = <0xc8100014 0x08 0xc810002c 0x04 0xc8100024 0x08>;
			#gpio-cells = <0x02>;
		};

		ao_uart {
			phandle = <0x91>;

			mux {
				groups = "uart_tx_ao_a_0\0uart_rx_ao_a_0";
				function = "uart_ao";
			};
		};

		ao_b_uart {
			phandle = <0x1a>;

			mux {
				groups = "uart_tx_ao_b_0\0uart_rx_ao_b_0";
				function = "uart_ao_b";
			};
		};

		sd_to_ao_uart_pins {
			phandle = <0x4c>;

			mux {
				groups = "uart_tx_ao_a_0\0uart_rx_ao_a_0";
				function = "uart_ao";
				input-enable;
				bias-pull-up;
			};
		};

		ao_i2c {
			phandle = <0x92>;

			mux {
				groups = "i2c_sda_ao\0i2c_sck_ao";
				function = "i2c_ao";
			};
		};

		irblaster_pin {
			phandle = <0x94>;

			mux {
				groups = "ir_out_ao7";
				function = "ir_out";
			};
		};

		irblaster_pin1 {
			phandle = <0x95>;

			mux {
				groups = "ir_out_ao9";
				function = "ir_out";
			};
		};

		hdmitx_aocec {
			phandle = <0x70>;

			mux {
				groups = "ao_cec";
				function = "ao_cec";
			};
		};
	};

	PCM {
		dai-tdm-slot-width = <0x10>;
		compatible = "amlogic, aml-pcm-dai";
		clocks = <0x08 0x0d 0x08 0xdd 0x08 0xdf>;
		#sound-dai-cells = <0x00>;
		clock-names = "mpll0\0pcm_mclk\0pcm_sclk";
		dai-format = "dsp_a";
		dai-tdm-slot-tx-mask = <0x01>;
		pcm_mode = <0x01>;
		phandle = <0x7e>;
		dai-tdm-slot-rx-mask = <0x01>;
		dai-tdm-slot-num = <0x02>;
		pinctrl-names = "audio_pcm";
	};

	snd_dmic {
		compatible = "aml, aml_snd_dmic";
		clocks = <0x08 0xd5 0x08 0xd1>;
		resets = <0x08 0xd4>;
		#sound-dai-cells = <0x00>;
		clock-names = "pdm\0mclk";
		status = "disabled";
		phandle = <0xce>;
		reg = <0xd0042000 0x2000>;
		pinctrl-0 = <0x71>;
		reset-names = "pdm";
		pinctrl-names = "audio_dmic";
	};

	scpi_clocks {
		compatible = "arm, scpi-clks";

		scpi_clocks@0 {
			compatible = "arm, scpi-clk-indexed";
			#clock-cells = <0x01>;
			phandle = <0x0d>;
			clock-output-names = "vcpu";
			clock-indices = <0x00>;
		};
	};
};
