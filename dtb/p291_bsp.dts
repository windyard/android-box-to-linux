/dts-v1/;

/ {
	compatible = "amlogic, Gxl";
	model = "Amlogic";
	interrupt-parent = <0x01>;
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	amlogic-dt-id = "gxlx2_p291_1g";

	codec_mm {
		compatible = "amlogic, codec, mm";
		dev_name = "codec_mm";
		status = "okay";
		memory-region = <0x3d 0x3e>;
	};

	codec_io {
		compatible = "amlogic, codec_io";
		ranges;
		#address-cells = <0x01>;
		#size-cells = <0x01>;

		io_cbus_base {
			reg = <0xc1100000 0x100000>;
		};

		io_dmc_base {
			reg = <0xc8838000 0x400>;
		};

		io_vcbus_base {
			reg = <0xd0100000 0x40000>;
		};

		io_hiubus_base {
			reg = <0xc883c000 0x2000>;
		};

		io_aobus_base {
			reg = <0xc8100000 0x100000>;
		};

		io_dos_base {
			reg = <0xc8820000 0x10000>;
		};
	};

	cpu_iomap {
		compatible = "amlogic, iomap";
		ranges;
		#address-cells = <0x01>;
		#size-cells = <0x01>;

		io_apb_base {
			reg = <0xd0000000 0x200000>;
		};

		io_cbus_base {
			reg = <0xc1100000 0x100000>;
		};

		io_vapb_base {
			reg = <0xd0100000 0x100000>;
		};

		io_aobus_base {
			reg = <0xc8100000 0x100000>;
		};

		io_hiu_base {
			reg = <0xc883c000 0x2000>;
		};
	};

	amlvideo2_1 {
		compatible = "amlogic, amlvideo2";
		amlvideo2_id = <0x01>;
		dev_name = "amlvideo2";
		cma_mode = <0x01>;
		status = "okay";
	};

	bt-dev {
		compatible = "amlogic, bt-dev";
		dev_name = "bt-dev";
		gpio_en = <0x15 0x63 0x00>;
		status = "okay";
	};

	amvenc_avc {
		compatible = "amlogic, amvenc_avc";
		dev_name = "amvenc_avc";
		status = "okay";
		interrupts = <0x00 0x2d 0x01>;
		interrupt-names = "mailbox_2";
	};

	reserved-memory {
		ranges;
		#address-cells = <0x01>;
		#size-cells = <0x01>;

		linux,vdin1_cma {
			reusable;
			compatible = "shared-dma-pool";
			alignment = <0x400000>;
			alloc-ranges = <0x00 0x30000000>;
			size = <0x1400000>;
			phandle = <0x42>;
		};

		linux,ion-dev {
			reusable;
			compatible = "shared-dma-pool";
			alignment = <0x400000>;
			alloc-ranges = <0x00 0x30000000>;
			size = <0x4c00000>;
			phandle = <0x3b>;
		};

		linux,picdec {
			reusable;
			compatible = "shared-dma-pool";
			alignment = <0x00>;
			size = <0x00>;
			phandle = <0x3f>;
			linux,contiguous-region;
		};

		ramoops@0x07400000 {
			compatible = "ramoops";
			record-size = <0x8000>;
			console-size = <0x8000>;
			ftrace-size = <0x40000>;
			reg = <0x7400000 0x100000>;
		};

		linux,meson-fb {
			reusable;
			compatible = "shared-dma-pool";
			alignment = <0x400000>;
			alloc-ranges = <0x3f800000 0x800000>;
			size = <0x800000>;
			phandle = <0x3c>;
		};

		linux,ppmgr {
			reusable;
			compatible = "shared-dma-pool";
			alignment = <0x00>;
			size = <0x00>;
			phandle = <0x40>;
			linux,contiguous-region;
		};

		linux,secos {
			compatible = "amlogic, aml_secos_memory";
			status = "disable";
			no-map;
			phandle = <0xc6>;
			reg = <0x5300000 0x2000000>;
		};

		linux,di_cma {
			reusable;
			compatible = "shared-dma-pool";
			alignment = <0x400000>;
			alloc-ranges = <0x30000000 0x10000000>;
			size = <0x00>;
			phandle = <0x41>;
		};

		linux,codec_mm_cma {
			reusable;
			compatible = "shared-dma-pool";
			alignment = <0x400000>;
			size = <0x10400000>;
			phandle = <0x3d>;
			linux,contiguous-region;
		};

		linux,secmon {
			reusable;
			compatible = "shared-dma-pool";
			alignment = <0x400000>;
			alloc-ranges = <0x5000000 0x2400000>;
			size = <0x2400000>;
			phandle = <0x0f>;
		};

		linux,codec_mm_reserved {
			compatible = "amlogic, codec-mm-reserved";
			alignment = <0x100000>;
			size = <0x00>;
			phandle = <0x3e>;
		};
	};

	amlvecm {
		compatible = "amlogic, vecm";
		wb_en = <0x00>;
		dev_name = "aml_vecm";
		cm_en = <0x00>;
		status = "okay";
		cfg_en_osd_100 = <0x03>;
		gamma_en = <0x00>;
		tx_op_color_primary = <0x00>;
		wb_sel = <0x00>;
	};

	dummy {
		compatible = "amlogic, aml_dummy_codec";
		#sound-dai-cells = <0x00>;
		status = "disable";
		phandle = <0xcf>;
	};

	vout {
		compatible = "amlogic, vout";
		dev_name = "vout";
		fr_auto_policy = <0x00>;
		status = "okay";
	};

	watchdog@0xffd0f0d0 {
		compatible = "amlogic, meson-wdt";
		clocks = <0x11>;
		clock-names = "xtal";
		reset_watchdog_time = <0x02>;
		shutdown_timeout = <0x0a>;
		status = "okay";
		suspend_timeout = <0x06>;
		default_timeout = <0x0a>;
		phandle = <0x8d>;
		firmware_timeout = <0x06>;
		reg = <0xc11098d0 0x10>;
		reset_watchdog_method = <0x01>;
	};

	audio_data {
		compatible = "amlogic, audio_data";
		query_licence_cmd = <0x82000050>;
		status = "okay";
		phandle = <0xc1>;
	};

	defendkey {
		compatible = "amlogic, defendkey";
		status = "disabled";
		mem_size = <0x00 0x100000>;
		phandle = <0xc0>;
		reg = <0xc8834500 0x04>;
	};

	wifi {
		compatible = "amlogic, aml_wifi";
		interrupt_pin = <0x15 0x64 0x00>;
		dev_name = "aml_wifi";
		status = "okay";
		interrupts = <0x00 0x44 0x04>;
		dhd_static_buf;
		pinctrl-0 = <0x43>;
		power_on_pin = <0x15 0x58 0x00>;
		pinctrl-names = "wifi_32k_pins";
		irq_trigger_type = "GPIO_IRQ_HIGH";
	};

	dmc_monitor {
		compatible = "amlogic, dmc_monitor";
		status = "okay";
		interrupts = <0x00 0x33 0x01>;
		reg_base = <0xda838400>;
	};

	ion_dev {
		compatible = "amlogic, ion_dev";
		memory-region = <0x3b>;
	};

	meson-amvideom {
		compatible = "amlogic, amvideom";
		dev_name = "amvideom";
		status = "okay";
		interrupts = <0x00 0x03 0x01>;
		interrupt-names = "vsync";
	};

	amlvideo {
		compatible = "amlogic, amlvideo";
		dev_name = "amlvideo";
		status = "okay";
	};

	mali@d00c0000 {
		pmu_domain_config = <0x01 0x02 0x04 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x02 0x00>;
		compatible = "arm,mali-450";
		clocks = <0x08 0x97 0x08 0x09>;
		control_interval = <0xc8>;
		sc_mpp = <0x02>;
		clock-names = "gpu_mux\0gp0_pll";
		def_clock = <0x03>;
		tbl = <0x02 0x03 0x04 0x05 0x06 0x07>;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0xa0 0x04 0x00 0xa1 0x04 0x00 0xa2 0x04 0x00 0xa3 0x04 0x00 0xa4 0x04 0x00 0xa5 0x04 0x00 0xa6 0x04 0x00 0xa7 0x04>;
		phandle = <0x86>;
		reg = <0xd00c0000 0x40000 0xc1104440 0x1000 0xc8100000 0x1000 0xc883c000 0x1000 0xc1104440 0x1000>;
		#cooling-cells = <0x02>;
		interrupt-names = "IRQGP\0IRQGPMMU\0IRQPP\0IRQPMU\0IRQPP0\0IRQPPMMU0\0IRQPP1\0IRQPPMMU1";
		num_of_pp = <0x02>;
		pmu_switch_delay = <0xffff>;

		clk125_cfg {
			voltage = <0x47e>;
			threshold = <0x1e 0x78>;
			clk_parent = "fclk_div4";
			clkp_freq = <0x1dcd6500>;
			keep_count = <0x05>;
			clk_freq = <0x7735940>;
			phandle = <0x02>;
		};

		clk400_cfg {
			voltage = <0x47e>;
			threshold = <0x98 0xcf>;
			clk_parent = "fclk_div5";
			clkp_freq = <0x17d78400>;
			keep_count = <0x05>;
			clk_freq = <0x17d78400>;
			phandle = <0x04>;
		};

		clk750_cfg {
			voltage = <0x47e>;
			threshold = <0xe6 0xff>;
			clk_parent = "gp0_pll";
			clkp_freq = <0x2c588a00>;
			keep_count = <0x05>;
			clk_freq = <0x2c588a00>;
			phandle = <0x07>;
		};

		clk500_cfg {
			voltage = <0x47e>;
			threshold = <0xb4 0xdc>;
			clk_parent = "fclk_div4";
			clkp_freq = <0x1dcd6500>;
			keep_count = <0x05>;
			clk_freq = <0x1dcd6500>;
			phandle = <0x05>;
		};

		clk666_cfg {
			voltage = <0x47e>;
			threshold = <0xd2 0xec>;
			clk_parent = "fclk_div3";
			clkp_freq = <0x27b25a80>;
			keep_count = <0x05>;
			clk_freq = <0x27b25a80>;
			phandle = <0x06>;
		};

		clk285_cfg {
			voltage = <0x47e>;
			threshold = <0x64 0xbe>;
			clk_parent = "fclk_div7";
			clkp_freq = <0x10fcc140>;
			keep_count = <0x05>;
			clk_freq = <0x10fcc140>;
			phandle = <0x03>;
		};

		clk800_cfg {
			voltage = <0x47e>;
			threshold = <0xe6 0xff>;
			clk_parent = "gp0_pll";
			clkp_freq = <0x2f34f600>;
			keep_count = <0x05>;
			clk_freq = <0x2f34f600>;
			phandle = <0x89>;
		};

		clk250_cfg {
			voltage = <0x47e>;
			threshold = <0x50 0xaa>;
			clk_parent = "fclk_div4";
			clkp_freq = <0x1dcd6500>;
			keep_count = <0x05>;
			clk_freq = <0xee6b280>;
			phandle = <0x88>;
		};
	};

	secmon {
		compatible = "amlogic, secmon";
		in_base_func = <0x82000020>;
		out_base_func = <0x82000021>;
		reserve_mem_size = <0x2300000>;
		memory-region = <0x0f>;
	};

