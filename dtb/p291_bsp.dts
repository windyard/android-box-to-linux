			phandle = <0x1e>;
		};

		key_0 {
			offset = <0x00>;
			keyname = "mac";
			size = <0x06>;
			phandle = <0x1c>;
		};

		key_3 {
			offset = <0x12>;
			keyname = "usid";
			size = <0x10>;
			phandle = <0x1f>;
		};

		key_1 {
