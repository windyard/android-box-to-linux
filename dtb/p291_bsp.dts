	vdin0 {
		compatible = "amlogic, vdin";
		clocks = <0x08 0x07 0x08 0xcd>;
		tv_bit_mode = <0x15>;
		dev_name = "vdin0";
		flag_cma = <0x01>;
		clock-names = "fclk_div5\0cts_vdin_meas_clk";
		status = "okay";
		interrupts = <0x00 0x53 0x01>;
		cma_size = <0x18>;
		rdma-irq = <0x02>;
		vdin_id = <0x00>;
		reserve-iomap = "true";
	};

	firmware {

		android {
			compatible = "android,firmware";

			fstab {
				compatible = "android,fstab";

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/vendor";
					type = "ext4";
					fsmgr_flags = "wait";
					mnt_flags = "ro,barrier=1,inode_readahead_blks=8";
				};

				system {
					compatible = "android,system";
					dev = "/dev/block/system";
					type = "ext4";
					fsmgr_flags = "wait";
					mnt_flags = "ro,barrier=1,inode_readahead_blks=8";
				};

				product {
					compatible = "android,product";
					dev = "/dev/block/product";
					type = "ext4";
					fsmgr_flags = "wait";
					mnt_flags = "ro,barrier=1,inode_readahead_blks=8";
				};

				odm {
					compatible = "android,odm";
					dev = "/dev/block/odm";
					type = "ext4";
					fsmgr_flags = "wait";
					mnt_flags = "ro,barrier=1,inode_readahead_blks=8";
				};
			};

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor";
				by_name_prefix = "/dev/block";
			};
		};
	};

