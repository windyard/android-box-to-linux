	ddr_bandwidth {
		compatible = "amlogic, ddr-bandwidth";
		sec_base = <0xda838400>;
		status = "okay";
		interrupts = <0x00 0x34 0x01>;
		reg = <0xc8838000 0x100 0xc8837000 0x100>;
		interrupt-names = "ddr_bandwidth";
	};

	arm_pmu {
		compatible = "arm,cortex-a15-pmu";
		interrupts = <0x00 0x89 0x04 0x00 0x8a 0x04 0x00 0x99 0x04 0x00 0x9a 0x04>;
	};

	soc {
		compatible = "simple-bus";
		ranges;
		#address-cells = <0x01>;
		#size-cells = <0x01>;

		hiubus@c883c000 {
			compatible = "simple-bus";
			ranges = <0x00 0xc883c000 0x2000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			phandle = <0xbf>;
			reg = <0xc883c000 0x2000>;

			clock-controller@0 {
				compatible = "amlogic,gxl-clkc";
				#reset-cells = <0x01>;
				#clock-cells = <0x01>;
				phandle = <0x08>;
				reg = <0x00 0x3db>;
			};
		};

		periphs@c8834000 {
			compatible = "simple-bus";
			ranges = <0x00 0xc8834000 0x2000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			phandle = <0xbe>;
			reg = <0xc8834000 0x2000>;

			rng {
				quality = [03 e8];
				compatible = "amlogic,meson-rng";
				reg = <0x00 0x04>;
			};
		};

		aobus@c8100000 {
			compatible = "simple-bus";
			ranges = <0x00 0xc8100000 0x100000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			phandle = <0xbb>;
			reg = <0xc8100000 0x100000>;

			serial@4e0 {
				compatible = "amlogic, meson-uart";
				clocks = <0x11>;
				fifosize = <0x40>;
				clock-names = "clk_uart";
				status = "disable";
				interrupts = <0x00 0xc5 0x01>;
				phandle = <0xbd>;
				reg = <0x4e0 0x18>;
				pinctrl-0 = <0x1a>;
				pinctrl-names = "default";
			};

			serial@4c0 {
				compatible = "amlogic, meson-uart";
				clocks = <0x11>;
				xtal_tick_en = <0x01>;
				fifosize = <0x40>;
				clock-names = "clk_uart";
				status = "okay";
				interrupts = <0x00 0xc1 0x01>;
				phandle = <0xbc>;
				reg = <0x4c0 0x18>;
				support-sysrq = <0x00>;
				pinctrl-names = "default";
			};

			cpu_version {
				reg = <0x220 0x04>;
			};
		};

		cbus@c1100000 {
			compatible = "simple-bus";
			ranges = <0x00 0xc1100000 0x100000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			phandle = <0xb2>;
			reg = <0xc1100000 0x100000>;

			serial@8700 {
				compatible = "amlogic, meson-uart";
				clocks = <0x08 0x57>;
				fifosize = <0x40>;
				clock-names = "clk_uart";
				status = "disabled";
				interrupts = <0x00 0x5d 0x01>;
				phandle = <0xb6>;
				reg = <0x8700 0x18>;
				pinctrl-0 = <0x19>;
				pinctrl-names = "default";
			};

			serial@84dc {
				compatible = "amlogic, meson-uart";
				clocks = <0x08 0x40>;
				fifosize = <0x40>;
				clock-names = "clk_uart";
				status = "disabled";
				interrupts = <0x00 0x4b 0x01>;
				phandle = <0xb5>;
				reg = <0x84dc 0x18>;
				pinctrl-0 = <0x18>;
				pinctrl-names = "default";
			};

			interrupt-controller@9880 {
				compatible = "amlogic,meson-gpio-intc\0amlogic,meson-gxl-gpio-intc";
				status = "okay";
				#interrupt-cells = <0x02>;
				phandle = <0xb3>;
				reg = <0x9880 0x10>;
				amlogic,channel-interrupts = <0x40 0x41 0x42 0x43 0x44 0x45 0x46 0x47>;
				interrupt-controller;
			};

			meson_clk_msr {
				compatible = "amlogic,gxlx-measure";
				reg = <0x875c 0x04 0x8764 0x04>;
			};

			i2c@8500 {
				compatible = "amlogic,meson-gx-i2c";
				clocks = <0x08 0x1f>;
				clock-names = "clk_i2c";
				status = "disabled";
				#address-cells = <0x01>;
				interrupts = <0x00 0x15 0x01 0x00 0x2f 0x01>;
				#size-cells = <0x00>;
				phandle = <0xb7>;
				reg = <0x8500 0x20>;
			};

			i2c@8d20 {
				compatible = "amlogic,meson-gx-i2c";
				clocks = <0x08 0x1f>;
				clock-names = "clk_i2c";
				status = "okay";
				#address-cells = <0x01>;
				interrupts = <0x00 0x27 0x01 0x00 0x32 0x01>;
				#size-cells = <0x00>;
				phandle = <0xba>;
				reg = <0x8d20 0x20>;
			};

			serial@84c0 {
				compatible = "amlogic, meson-uart";
				clocks = <0x08 0x23>;
				fifosize = <0x80>;
				clock-names = "clk_uart";
				status = "okay";
				interrupts = <0x00 0x1a 0x01>;
				phandle = <0xb4>;
				reg = <0x84c0 0x18>;
				pinctrl-0 = <0x17>;
				pinctrl-names = "default";
			};

			i2c@87e0 {
				compatible = "amlogic,meson-gx-i2c";
				clocks = <0x08 0x1f>;
				clock-names = "clk_i2c";
				status = "disabled";
				#address-cells = <0x01>;
				interrupts = <0x00 0xd7 0x01 0x00 0x31 0x01>;
				#size-cells = <0x00>;
				phandle = <0xb9>;
				reg = <0x87e0 0x20>;
			};

			i2c@87c0 {
				compatible = "amlogic,meson-gx-i2c";
				clocks = <0x08 0x1f>;
				clock-names = "clk_i2c";
				status = "disabled";
				#address-cells = <0x01>;
				interrupts = <0x00 0xd6 0x01 0x00 0x30 0x01>;
				#size-cells = <0x00>;
				phandle = <0xb8>;
				reg = <0x87c0 0x20>;
			};
		};
	};

	vdec {
		compatible = "amlogic, vdec";
		dev_name = "vdec.0";
		status = "okay";
		interrupts = <0x00 0x03 0x01 0x00 0x17 0x01 0x00 0x20 0x01 0x00 0x2b 0x01 0x00 0x2c 0x01 0x00 0x2d 0x01>;
		interrupt-names = "vsync\0demux\0parser\0mailbox_0\0mailbox_1\0mailbox_2";
	};

	spifc@c1108c80 {
		compatible = "amlogic,aml-spi-nor";
		clocks = <0x08 0x0c>;
		clock-names = "core";
		status = "disabled";
		phandle = <0x8e>;
		reg = <0xc1108c80 0x80>;
		pinctrl-0 = <0x14>;
		pinctrl-names = "default";

		spi-nor@0 {
			read-capability = <0x01>;
			spifc-frequency = <0xf42400>;
			spinor_partition = <0x16>;
			cs_gpios = <0x15 0x2c 0x00>;
			spifc-io-width = <0x01>;

			spinor_partitions {
				phandle = <0x16>;

				user {
					offset = <0x00 0x00>;
					size = <0x00 0x680000>;
				};

				bootloader {
					offset = <0x00 0x00>;
					size = <0x00 0x100000>;
				};

				env {
					offset = <0x00 0x00>;
					size = <0x00 0x40000>;
				};

				boot {
					offset = <0x00 0x00>;
					size = <0x00 0x800000>;
				};

				dtb {
					offset = <0x00 0x00>;
					size = <0x00 0x40000>;
				};
			};
		};
	};

	efusekey {
		key3 = <0x1f>;
		keynum = <0x04>;
		key1 = <0x1d>;
		key2 = <0x1e>;
		phandle = <0x1b>;
		key0 = <0x1c>;

		key_2 {
			offset = <0x0c>;
			keyname = "mac_wifi";
