#!/bin/sh
# R1200C Alpine bring-up (Linux-only; root on eMMC /dev/data).
ip link set lo up 2>/dev/null
ifup lo 2>/dev/null
ifup eth0 2>/dev/null || {
    ip addr add 192.0.2.126/24 dev eth0 2>/dev/null
    ip link set eth0 up 2>/dev/null
    ip route add default via 192.0.2.1 2>/dev/null
}
# zram: 256 MiB of RAM-backed swap.  The BSP ships /dev/zram0 with disksize=0,
# i.e. present but unconfigured, and zram is compiled in (there is a
# /sys/class/zram-control hot_add interface and no module to load), so this is
# three writes and no eMMC wear.  disksize is a ceiling, not an allocation: the
# pages cost real RAM only once something is swapped into them.  The ceiling is
# deliberately far below the 989 MiB this box has - a swap device larger than
# physical memory does not prevent an OOM, it just converts it into a hang.
#
# Branch on the outcome (is swap active?) rather than on the setting, and say
# which happened: an assignment that silently no-ops is the failure mode this
# whole bring-up keeps running into.  Takes the first branch on a manual
# re-run, which is the only reason the guard exists.
if grep -q '^/dev/zram0' /proc/swaps 2>/dev/null; then
    echo "zram0: swap already active" > /dev/kmsg
elif echo $((256 * 1024 * 1024)) > /sys/block/zram0/disksize 2>/dev/null \
        && mkswap /dev/zram0 >/dev/null 2>&1 \
        && swapon /dev/zram0 >/dev/null 2>&1; then
    echo "zram0: 256M swap on" > /dev/kmsg
else
    echo "zram0: swap setup FAILED" > /dev/kmsg
fi
# No RTC battery: the clock comes up at whatever the RTC last held, so seed a
# known-valid floor (2026-09-19) first.  This is what makes TLS and apk cert
# checks work in the window before NTP lands; it is ~2 days behind real time.
#
# The old one-liner here ran 'ntpd -q' against the router exactly once, before
# eth0 had a lease, and then wrote whatever clock it had to the RTC - which is
# how the floor itself got baked into the hardware clock on every boot.  Real
# sync + verification + a trusted-RTC-write now lives in time-up.sh (see its
# header for why busybox ntpd's exit status cannot be trusted).
date -u -s "@1789776000" 2>/dev/null
( /usr/local/bin/time-up.sh ) &
# SSH: dropbear, key-auth only (no password logins), host keys auto-created if
# absent so the daemon always comes up.  Replaces the old plaintext nc:2323 root
# shell.  Authorized keys live in /root/.ssh/authorized_keys.
mkdir -p /etc/dropbear /root/.ssh 2>/dev/null
[ -f /etc/dropbear/dropbear_ed25519_host_key ] || dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key >/dev/null 2>&1
[ -f /etc/dropbear/dropbear_rsa_host_key ] || dropbearkey -t rsa -f /etc/dropbear/dropbear_rsa_host_key >/dev/null 2>&1
chmod 700 /root/.ssh 2>/dev/null; chmod 600 /root/.ssh/authorized_keys 2>/dev/null
/usr/sbin/dropbear -s -p 22
( busybox chown -R 0:0 /root /home /etc /var /usr/local /opt 2>/dev/null
  touch /root/.ownership-fixed ) &
echo "r1200c alpine up: ssh on tcp/22 (key-auth)" > /dev/kmsg
( /usr/local/bin/wifi-up.sh ) &
echo "wifi bring-up started" > /dev/kmsg
# Display: re-apply OSD recipe + start X (README 7.7).  Last, after dropbear
# is up, so a broken display hook can never cost us the SSH lifeline.
( /usr/local/bin/display-up.sh ) &
exit 0
